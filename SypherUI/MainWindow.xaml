<Window x:Class="SypherUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SypherUI"
        Title="[SypherAI] Cybersecurity Chatbot"
        Height="680" Width="980"
        MinHeight="580" MinWidth="780"
        Background="White"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Converters -->
        <local:MessageAlignmentConverter x:Key="AlignConv"/>
        <local:MessageBackgroundConverter x:Key="BgConv"/>
        <local:MessageForegroundConverter x:Key="FgConv"/>

        <!-- Sidebar conversation button -->
        <Style x:Key="ConvBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="10,7">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0E2D5C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action buttons -->
        <Style x:Key="ActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#133E82"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A52B0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#D0DCF0"/>
                                <Setter Property="Foreground" Value="#8A9FC0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text inputs -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A202C"/>
            <Setter Property="CaretBrush" Value="#133E82"/>
            <Setter Property="BorderBrush" Value="#CBD5E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#133E82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Image Source="Screenshot 2026-05-15 095847.png"
               Stretch="UniformToFill" Opacity="0.06"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="#010E22" BorderBrush="#133E82" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- New Chat -->
                    <Border Grid.Row="0" Padding="12,14,12,10">
                        <Button x:Name="NewChatBtn" Style="{StaticResource ActionBtnStyle}" Height="36" 
                                HorizontalAlignment="Stretch" Click="NewChat_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="＋" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="New Chat" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- Conversations -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="8,0,8,8">
                            <TextBlock Text="CONVERSATIONS"
                                       Foreground="#3A4A60"
                                       FontSize="9" FontWeight="Bold"
                                       Margin="6,6,0,8"/>

                            <Button Style="{StaticResource ConvBtnStyle}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Incident Response"
                                                   Foreground="White" FontSize="11"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Help analyse this suspicious log..."
                                                   Foreground="#4A5568" FontSize="9"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="2:45 PM"
                                               Foreground="#3A4A60" FontSize="9"
                                               VerticalAlignment="Top" Margin="4,1,0,0"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource ConvBtnStyle}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Malware Analysis"
                                                   Foreground="White" FontSize="11"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="What indicators are present in..."
                                                   Foreground="#4A5568" FontSize="9"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="12:16 PM"
                                               Foreground="#3A4A60" FontSize="9"
                                               VerticalAlignment="Top" Margin="4,1,0,0"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource ConvBtnStyle}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Phishing Investigation"
                                                   Foreground="White" FontSize="11"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Identify phishing indicators in..."
                                                   Foreground="#4A5568" FontSize="9"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Yesterday"
                                               Foreground="#3A4A60" FontSize="9"
                                               VerticalAlignment="Top" Margin="4,1,0,0"/>
                                </Grid>
                            </Button>

                            <Button Style="{StaticResource ConvBtnStyle}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Network Security"
                                                   Foreground="White" FontSize="11"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="Review firewall logs for..."
                                                   Foreground="#4A5568" FontSize="9"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Yesterday"
                                               Foreground="#3A4A60" FontSize="9"
                                               VerticalAlignment="Top" Margin="4,1,0,0"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Profile Footer -->
                    <Border Grid.Row="2" Padding="12,10" BorderBrush="#133E82" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="34" Height="34" Margin="0,0,10,0">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="icons8-profile-48.png"
                                                Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="usernameLabel"
                                           Text="Username"
                                           Foreground="White"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="#00D084"
                                             Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Online" Foreground="#00D084" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN CONTENT AREA -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ASCII Art -->
                <Border Grid.Row="0" Padding="0,18,0,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Image Source="sypher ascii.png" Height="60" HorizontalAlignment="Center" Stretch="Uniform"/>
                </Border>

                <!-- Name Input -->
                <Border Grid.Row="1" Padding="20,10,20,10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Name:" Foreground="#4A5568" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="nameinput" Style="{StaticResource InputStyle}" Width="180" Height="34"/>
                        <Button x:Name="nameSendBtn" Content="Send" Style="{StaticResource ActionBtnStyle}" 
                                Height="34" Margin="8,0,0,0" Click="Button_Click"/>
                    </StackPanel>
                </Border>

                <!-- Chat Messages -->
                <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,12,18,12">
                    <ItemsControl x:Name="ChatItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Border HorizontalAlignment="{Binding Converter={StaticResource AlignConv}}"
                                            Background="{Binding Converter={StaticResource BgConv}}"
                                            CornerRadius="10" Padding="13,9" MaxWidth="480">
                                        <TextBlock Text="{Binding Text}"
                                                   Foreground="{Binding Converter={StaticResource FgConv}}"
                                                   TextWrapping="Wrap" FontSize="12" LineHeight="19"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Message Input -->
                <Border Grid.Row="3" Padding="16,10,16,14" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtInput" Grid.Column="0" Style="{StaticResource InputStyle}"
                                 Text="Type your message..." Height="36"
                                 KeyDown="MessageInput_KeyDown"
                                 GotFocus="RemovePlaceholder"
                                 LostFocus="AddPlaceholder"/>
                        <Button x:Name="txtSendBtn" Grid.Column="1" Content="Send" 
                                Style="{StaticResource ActionBtnStyle}" Height="36" Margin="8,0,0,0"
                                Click="Button_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>